{
  "name": "yrm-barber",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --config wrangler.jsonc --env production --remote",
    "db:seed": "wrangler d1 execute DB --local --file scripts/seed.sql",
    "admin:create": "node scripts/admin.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev:wrangler": "npm run build && wrangler dev --local --ip 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "@tanstack/react-query": "^5.90.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.12.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.27.0",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "globals": "^17.0.0",
    "miniflare": "5.20261123.1-beta",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.0",
    "wrangler": "^4.70.0"
  }
}
